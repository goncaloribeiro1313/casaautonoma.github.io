<mxfile host="app.diagrams.net" agent="ChatGPT">
  <diagram id="story" name="Storytelling SmartHome OS">
    <mxGraphModel dx="1202" dy="587" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=27;align=center;verticalAlign=middle;spacing=12;" value="&lt;b&gt;STORYTELLING | SMARTHOME OS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Casa Autónoma&lt;/font&gt;" vertex="1">
          <mxGeometry height="95" width="970" x="95" y="35" as="geometry" />
        </mxCell>
        <mxCell id="n0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#B3C6D8;strokeWidth=1.5;fontColor=#18344F;fontSize=17;align=left;verticalAlign=middle;spacingLeft=26;spacingRight=20;spacingTop=12;" value="&lt;b&gt;01 · O PROBLEMA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Numa casa, é difícil acompanhar tudo ao mesmo tempo: luzes acesas, temperatura, portas e possíveis perigos.&lt;br&gt;&lt;font color=&quot;#45627F&quot;&gt;&lt;i&gt;Quero tornar a gestão da casa mais simples e segura.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="133" width="900" x="130" y="165" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F7FF;strokeColor=#B3C6D8;strokeWidth=1.5;fontColor=#18344F;fontSize=17;align=left;verticalAlign=middle;spacingLeft=26;spacingRight=20;spacingTop=12;" value="&lt;b&gt;02 · A MINHA IDEIA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Criar o SmartHome OS: um painel numa página HTML para consultar informações e controlar a casa.&lt;br&gt;&lt;font color=&quot;#45627F&quot;&gt;&lt;i&gt;O utilizador vê tudo no computador ou telemóvel.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="133" width="900" x="130" y="329" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="n0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#53749B;strokeWidth=2;" target="n1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F5;strokeColor=#B3C6D8;strokeWidth=1.5;fontColor=#18344F;fontSize=17;align=left;verticalAlign=middle;spacingLeft=26;spacingRight=20;spacingTop=12;" value="&lt;b&gt;03 · RECOLHER INFORMAÇÕES&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sensores detetam temperatura, movimento, luminosidade, fumo e abertura de portas.&lt;br&gt;&lt;font color=&quot;#45627F&quot;&gt;&lt;i&gt;Os dados são enviados ao computador central.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="133" width="900" x="130" y="493" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="n1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#53749B;strokeWidth=2;" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#B3C6D8;strokeWidth=1.5;fontColor=#18344F;fontSize=17;align=left;verticalAlign=middle;spacingLeft=26;spacingRight=20;spacingTop=12;" value="&lt;b&gt;04 · TOMAR DECISÕES&lt;/b&gt;&lt;br&gt;&lt;br&gt;O programa analisa os dados e aplica regras: se estiver escuro e houver movimento, ligar a luz.&lt;br&gt;&lt;font color=&quot;#45627F&quot;&gt;&lt;i&gt;É a automatização da casa.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="133" width="900" x="130" y="657" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="n2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#53749B;strokeWidth=2;" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEFF0;strokeColor=#B3C6D8;strokeWidth=1.5;fontColor=#18344F;fontSize=17;align=left;verticalAlign=middle;spacingLeft=26;spacingRight=20;spacingTop=12;" value="&lt;b&gt;05 · ENVIAR NOTIFICAÇÕES&lt;/b&gt;&lt;br&gt;&lt;br&gt;Se uma porta abrir ou for detetado fumo, aparece um aviso no painel.&lt;br&gt;&lt;font color=&quot;#45627F&quot;&gt;&lt;i&gt;O utilizador é informado do que aconteceu.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="133" width="900" x="130" y="821" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="n3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#53749B;strokeWidth=2;" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF4FF;strokeColor=#B3C6D8;strokeWidth=1.5;fontColor=#18344F;fontSize=17;align=left;verticalAlign=middle;spacingLeft=26;spacingRight=20;spacingTop=12;" value="&lt;b&gt;06 · CONTROLAR À DISTÂNCIA&lt;/b&gt;&lt;br&gt;&lt;br&gt;No painel, carrego em «Ligar luz da sala». O sistema recebe o comando e altera o estado da luz.&lt;br&gt;&lt;font color=&quot;#45627F&quot;&gt;&lt;i&gt;O controlo começa dentro da mesma rede Wi-Fi.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="133" width="900" x="130" y="985" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="n4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#53749B;strokeWidth=2;" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF7F2;strokeColor=#B3C6D8;strokeWidth=1.5;fontColor=#18344F;fontSize=17;align=left;verticalAlign=middle;spacingLeft=26;spacingRight=20;spacingTop=12;" value="&lt;b&gt;07 · ACOMPANHAR EM TEMPO REAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;O painel mostra temperatura, portas e luzes, atualizando os valores automaticamente.&lt;br&gt;&lt;font color=&quot;#45627F&quot;&gt;&lt;i&gt;Também quero guardar um histórico de eventos.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="133" width="900" x="130" y="1149" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="n5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#53749B;strokeWidth=2;" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0FC;strokeColor=#B3C6D8;strokeWidth=1.5;fontColor=#18344F;fontSize=17;align=left;verticalAlign=middle;spacingLeft=26;spacingRight=20;spacingTop=12;" value="&lt;b&gt;08 · COMO VOU CONSTRUIR&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Melhorar o HTML  →  2. Preparar o servidor  →  3. Programar em Python  →  4. Ligar sensores/LEDs  →  5. Testar&lt;br&gt;&lt;font color=&quot;#45627F&quot;&gt;&lt;i&gt;Primeiro faço uma simulação; depois passo aos dispositivos reais.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="133" width="900" x="130" y="1313" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="n6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#53749B;strokeWidth=2;" target="n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3FB;strokeColor=#B3C6D8;strokeWidth=1.5;fontColor=#18344F;fontSize=17;align=left;verticalAlign=middle;spacingLeft=26;spacingRight=20;spacingTop=12;" value="&lt;b&gt;09 · RESULTADO ESPERADO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Uma demonstração simples com notificações, automatização, controlo remoto e monitorização.&lt;br&gt;&lt;font color=&quot;#45627F&quot;&gt;&lt;i&gt;A casa responde aos acontecimentos e aos comandos do utilizador.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="133" width="900" x="130" y="1477" as="geometry" />
